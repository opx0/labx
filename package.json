{
  "name": "datahubx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "echo 'db:push is disabled \u2014 use db:migrate so schema history stays reviewable' && exit 1",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "health": "bun run scripts/healthcheck.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.39",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "6",
    "ai": "^7.0.58",
    "next": "^16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
