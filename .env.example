# Copy to .env.local and fill in.

# DataHub GMS endpoint (datahub docker quickstart default: http://localhost:8080)
DATAHUB_GMS_URL=http://localhost:8080

# Personal access token, minted in the DataHub UI (Settings -> Access Tokens).
# Requires METADATA_SERVICE_AUTH_ENABLED=true on gms and frontend — see README.
DATAHUB_TOKEN=

# Postgres from `docker compose up -d`
DATABASE_URL=postgresql://datahubx:datahubx_dev@localhost:5435/datahubx

# Gemini key — only needed for the natural-language agent panel.
# Everything else (console buttons, golden scenario, tests) works without it.
GOOGLE_GENERATIVE_AI_API_KEY=
